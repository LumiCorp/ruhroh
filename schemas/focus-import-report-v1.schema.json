{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://lumicorp.github.io/ruhroh/schemas/focus-import-report-v1.schema.json", "title": "Ruhroh FOCUS Import Report v1",
  "type": "object", "additionalProperties": false, "required": ["version", "reportId", "createdAt", "focusVersion", "releaseStatus", "bundleRef", "specLockRef", "mappingPackRef", "conformanceReportRefs", "datasets", "currencies", "relationshipCoverage", "readiness", "blockers"],
  "properties": { "version": { "const": "ruhroh_focus_import_report_v1" }, "reportId": { "type": "string", "minLength": 1 }, "createdAt": { "type": "string", "format": "date-time" }, "focusVersion": { "type": "string", "minLength": 1 }, "releaseStatus": { "enum": ["ratified", "preview"] }, "bundleRef": { "$ref": "#/$defs/ref" }, "specLockRef": { "$ref": "#/$defs/ref" }, "mappingPackRef": { "$ref": "#/$defs/ref" }, "conformanceReportRefs": { "type": "array", "items": { "$ref": "#/$defs/ref" } }, "datasets": { "type": "array", "items": { "$ref": "#/$defs/datasetReport" } }, "currencies": { "type": "array", "items": { "$ref": "#/$defs/currency" } }, "normalizedRowsRef": { "$ref": "#/$defs/ref" }, "relationshipCoverage": { "type": "array", "items": { "$ref": "#/$defs/relationship" } }, "readiness": { "enum": ["draft", "review_required", "ready"] }, "blockers": { "$ref": "#/$defs/strings" } },
  "$defs": { "dataset": { "enum": ["CostAndUsage", "BillingPeriod", "InvoiceDetail", "ContractCommitment"] }, "ref": { "type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": { "path": { "type": "string", "minLength": 1 }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } }, "strings": { "type": "array", "items": { "type": "string" } }, "decimal": { "type": "string", "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]*[1-9])?$" }, "datasetReport": { "type": "object", "additionalProperties": false, "required": ["dataset", "sourceRows", "acceptedRows", "rejectedRows", "unknownColumns"], "properties": { "dataset": { "$ref": "#/$defs/dataset" }, "sourceRows": { "type": "integer", "minimum": 0 }, "acceptedRows": { "type": "integer", "minimum": 0 }, "rejectedRows": { "type": "integer", "minimum": 0 }, "unknownColumns": { "$ref": "#/$defs/strings" } } }, "currency": { "type": "object", "additionalProperties": false, "required": ["currency", "sourceAmountDecimal", "normalizedAmountDecimal", "differenceDecimal"], "properties": { "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }, "sourceAmountDecimal": { "$ref": "#/$defs/decimal" }, "normalizedAmountDecimal": { "$ref": "#/$defs/decimal" }, "differenceDecimal": { "$ref": "#/$defs/decimal" } } }, "relationship": { "type": "object", "additionalProperties": false, "required": ["relationship", "referenced", "matched", "missing", "ambiguous"], "properties": { "relationship": { "enum": ["cost_to_invoice_detail", "cost_to_billing_period", "cost_to_contract_commitment"] }, "referenced": { "type": "integer", "minimum": 0 }, "matched": { "type": "integer", "minimum": 0 }, "missing": { "type": "integer", "minimum": 0 }, "ambiguous": { "type": "integer", "minimum": 0 } } } }
}
