{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lumicorp.github.io/ruhroh/schemas/suite-v2.schema.json",
  "title": "Ruhroh Benchmark Suite v2",
  "type": "object",
  "additionalProperties": true,
  "required": ["version", "id", "title", "suiteVersion", "description", "scenarioIds", "scenarioVersions", "methodology", "governance"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": "ruhroh_suite_v2" },
    "id": { "type": "string", "pattern": "^[a-zA-Z0-9._-]+$" },
    "title": { "type": "string", "minLength": 1 },
    "suiteVersion": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "scenarioIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-zA-Z0-9._-]+$" }
    },
    "scenarioVersions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "methodology": {
      "type": "object",
      "additionalProperties": true,
      "required": ["minRuns", "aggregationUnit", "reportPolicy", "confidenceLevel", "retryPolicy", "efficiency"],
      "properties": {
        "minRuns": { "type": "integer", "minimum": 1 },
        "aggregationUnit": { "const": "scenario_benchmark_target" },
        "reportPolicy": { "const": "pass_rate_ci_pass_at_k_outcome_frontier" },
        "confidenceLevel": { "const": 0.95 },
        "retryPolicy": { "type": "string", "minLength": 1 },
        "efficiency": { "$ref": "#/$defs/efficiency" }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": true,
      "required": ["owner", "changelog", "acceptanceCriteria", "contaminationReview", "rewardHackingReview", "reviewChecklist", "deprecationPolicy"],
      "properties": {
        "owner": { "type": "string", "minLength": 1 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "changelog": { "$ref": "#/$defs/nonEmptyStringArray" },
        "acceptanceCriteria": { "$ref": "#/$defs/nonEmptyStringArray" },
        "contaminationReview": { "type": "string", "minLength": 1 },
        "rewardHackingReview": { "type": "string", "minLength": 1 },
        "reviewChecklist": { "$ref": "#/$defs/nonEmptyStringArray" },
        "deprecationPolicy": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "stringArray": { "type": "array", "items": { "type": "string" } },
    "nonEmptyStringArray": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "efficiency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["denominator", "aggregation", "suitableWorkloads", "requiredEvidence", "hiddenWork", "gamingRisks", "qualityFloor", "objectives", "bootstrap"],
      "properties": {
        "denominator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "predicate", "failedWork"],
          "properties": {
            "id": { "const": "accepted_scenario_outcome" },
            "predicate": { "const": "score_1_and_eval_passed" },
            "failedWork": { "const": "included_in_resource_numerator" }
          }
        },
        "aggregation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["weighting", "failedWork"],
          "properties": {
            "weighting": { "const": "run_plan" },
            "failedWork": { "const": "included_in_resource_numerator" }
          }
        },
        "suitableWorkloads": { "$ref": "#/$defs/nonEmptyStringArray" },
        "requiredEvidence": { "$ref": "#/$defs/nonEmptyStringArray" },
        "hiddenWork": { "$ref": "#/$defs/nonEmptyStringArray" },
        "gamingRisks": { "$ref": "#/$defs/nonEmptyStringArray" },
        "qualityFloor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["metric", "rule", "threshold", "scope"],
          "properties": {
            "metric": { "const": "pass_rate" },
            "rule": { "const": "wilson_lower_bound_gte" },
            "threshold": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
            "scope": { "const": "each_scenario" }
          }
        },
        "objectives": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["cost_per_accepted_outcome", "tokens_per_accepted_outcome", "p95_implementation_wall_time_ms"] }
        },
        "bootstrap": {
          "type": "object",
          "additionalProperties": false,
          "required": ["resamples", "minValidResamples", "confidenceLevel", "stratification"],
          "properties": {
            "resamples": { "const": 1000 },
            "minValidResamples": { "const": 950 },
            "confidenceLevel": { "const": 0.95 },
            "stratification": { "const": "scenario" }
          }
        }
      }
    }
  }
}
