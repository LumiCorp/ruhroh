{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://lumicorp.github.io/ruhroh/schemas/focus-spec-lock-v1.schema.json", "title": "Ruhroh FOCUS Spec Lock v1",
  "type": "object", "additionalProperties": false,
  "required": ["version", "profileId", "focusVersion", "releaseStatus", "specification", "validator", "datasets", "retrievedAt"],
  "properties": {
    "version": { "const": "ruhroh_focus_spec_lock_v1" }, "profileId": { "type": "string", "minLength": 1 }, "focusVersion": { "type": "string", "minLength": 1 }, "releaseStatus": { "enum": ["ratified", "preview"] },
    "specification": { "type": "object", "additionalProperties": false, "required": ["repository", "ref", "commitSha", "releaseAssets", "model"], "properties": { "repository": { "type": "string", "minLength": 1 }, "ref": { "type": "string", "minLength": 1 }, "commitSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" }, "releaseAssets": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/asset" } }, "model": { "$ref": "#/$defs/ref" } } },
    "validator": { "type": "object", "additionalProperties": false, "required": ["repository", "version", "commitSha"], "properties": { "repository": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 }, "commitSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" } } },
    "datasets": { "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": { "$ref": "#/$defs/dataset" } }, "retrievedAt": { "type": "string", "format": "date-time" }
  }, "$defs": { "dataset": { "enum": ["CostAndUsage", "BillingPeriod", "InvoiceDetail", "ContractCommitment"] }, "ref": { "type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": { "path": { "type": "string", "minLength": 1 }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } }, "asset": { "type": "object", "additionalProperties": false, "required": ["name", "path", "sha256", "upstreamDigest"], "properties": { "name": { "type": "string", "minLength": 1 }, "path": { "type": "string", "minLength": 1 }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "upstreamDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } } }
}
