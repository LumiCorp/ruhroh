{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://lumicorp.github.io/ruhroh/schemas/focus-dataset-bundle-v1.schema.json", "title": "Ruhroh FOCUS Dataset Bundle v1",
  "type": "object", "additionalProperties": false, "required": ["version", "bundleId", "focusVersion", "createdAt", "datasets", "relationships", "privacyClassification", "blockers"],
  "properties": { "version": { "const": "ruhroh_focus_dataset_bundle_v1" }, "bundleId": { "type": "string", "minLength": 1 }, "focusVersion": { "const": "1.4" }, "createdAt": { "type": "string", "format": "date-time" }, "datasets": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["dataset", "format", "sourceRef", "rowCount"], "properties": { "dataset": { "$ref": "#/$defs/dataset" }, "format": { "enum": ["csv", "parquet", "records"] }, "sourceRef": { "$ref": "#/$defs/ref" }, "rowCount": { "type": "integer", "minimum": 0 } } } }, "relationships": { "type": "array", "items": { "$ref": "#/$defs/relationship" } }, "privacyClassification": { "const": "restricted" }, "blockers": { "type": "array", "items": { "type": "string" } } },
  "$defs": { "dataset": { "enum": ["CostAndUsage", "BillingPeriod", "InvoiceDetail", "ContractCommitment"] }, "ref": { "type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": { "path": { "type": "string", "minLength": 1 }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } }, "relationship": { "type": "object", "additionalProperties": false, "required": ["relationship", "referenced", "matched", "missing", "ambiguous"], "properties": { "relationship": { "enum": ["cost_to_invoice_detail", "cost_to_billing_period", "cost_to_contract_commitment"] }, "referenced": { "type": "integer", "minimum": 0 }, "matched": { "type": "integer", "minimum": 0 }, "missing": { "type": "integer", "minimum": 0 }, "ambiguous": { "type": "integer", "minimum": 0 } } } }
}
