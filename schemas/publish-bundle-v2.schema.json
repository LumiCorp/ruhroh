{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lumicorp.github.io/ruhroh/schemas/publish-bundle-v2.schema.json",
  "title": "Ruhroh Publish Bundle Manifest v2",
  "type": "object",
  "additionalProperties": true,
  "required": ["$schema", "version", "createdAt", "source", "publishable", "blockerCount", "advisoryCount", "contracts", "files"],
  "properties": {
    "$schema": { "const": "https://lumicorp.github.io/ruhroh/schemas/publish-bundle-v2.schema.json" },
    "version": { "const": "ruhroh_publish_bundle_v2" },
    "createdAt": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "additionalProperties": true,
      "required": ["resultsPath", "bundlePath"],
      "properties": {
        "resultsPath": { "type": "string", "minLength": 1 },
        "bundlePath": { "type": "string", "minLength": 1 },
        "suiteId": { "type": "string", "minLength": 1 },
        "runPlanPath": { "type": "string", "minLength": 1 },
        "rerunLedgerPath": { "type": "string", "minLength": 1 },
        "evaluatorCalibrationReportPath": { "type": "string", "minLength": 1 }
      }
    },
    "publishable": { "type": "boolean" },
    "blockerCount": { "type": "integer", "minimum": 0 },
    "advisoryCount": { "type": "integer", "minimum": 0 },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publishCheck", "compare", "benchmarkClaim", "benchmarkSummary", "outcomeFrontier"],
      "properties": {
        "publishCheck": { "const": "ruhroh_publish_check_v2" },
        "compare": { "const": "ruhroh_compare_v2" },
        "benchmarkClaim": { "const": "ruhroh_benchmark_claim_v2" },
        "benchmarkSummary": { "const": "ruhroh_benchmark_summary_v2" },
        "outcomeFrontier": { "const": "ruhroh_outcome_frontier_v1" }
      }
    },
    "files": {
      "type": "array",
      "minItems": 13,
      "items": { "$ref": "#/$defs/bundleFile" }
    }
  },
  "$defs": {
    "bundleFile": {
      "type": "object",
      "additionalProperties": true,
      "required": ["role", "path", "description"],
      "properties": {
        "role": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    }
  }
}
