{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lumicorp.github.io/ruhroh/schemas/billing-mapping-profile-v2.schema.json",
  "title": "Ruhroh Billing Mapping Profile v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "profileId", "provider", "externalSchemaVersion", "fields", "kindValues", "matching", "allocations"],
  "properties": {
    "version": { "const": "ruhroh_billing_mapping_profile_v2" },
    "profileId": { "type": "string", "minLength": 1 },
    "provider": { "type": "string", "minLength": 1 },
    "externalSchemaVersion": { "type": "string", "minLength": 1 },
    "fields": { "type": "object", "additionalProperties": false, "required": ["sourceRowId", "amountDecimal", "currency", "kind"], "properties": { "sourceRowId": { "$ref": "#/$defs/nonEmpty" }, "amountDecimal": { "$ref": "#/$defs/nonEmpty" }, "currency": { "$ref": "#/$defs/nonEmpty" }, "kind": { "$ref": "#/$defs/nonEmpty" }, "occurredAt": { "$ref": "#/$defs/nonEmpty" }, "providerRequestId": { "$ref": "#/$defs/nonEmpty" }, "principalRef": { "$ref": "#/$defs/nonEmpty" }, "workloadId": { "$ref": "#/$defs/nonEmpty" }, "model": { "$ref": "#/$defs/nonEmpty" }, "sku": { "$ref": "#/$defs/nonEmpty" } } },
    "kindValues": { "type": "object", "additionalProperties": false, "properties": { "charge": { "$ref": "#/$defs/strings" }, "credit": { "$ref": "#/$defs/strings" }, "refund": { "$ref": "#/$defs/strings" }, "commitment": { "$ref": "#/$defs/strings" }, "tax": { "$ref": "#/$defs/strings" }, "prepaid": { "$ref": "#/$defs/strings" }, "capacity": { "$ref": "#/$defs/strings" }, "adjustment": { "$ref": "#/$defs/strings" } } },
    "matching": { "type": "object", "additionalProperties": false, "required": ["boundedWindowSeconds", "boundedFields"], "properties": { "boundedWindowSeconds": { "type": "number", "minimum": 0 }, "boundedFields": { "type": "array", "uniqueItems": true, "items": { "enum": ["principalRef", "workloadId", "model", "sku"] } } } },
    "allocations": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["sourceRowId", "targets"], "properties": { "sourceRowId": { "type": "string", "minLength": 1 }, "targets": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["workloadId", "assignedAmountDecimal"], "properties": { "workloadId": { "type": "string", "minLength": 1 }, "assignedAmountDecimal": { "$ref": "#/$defs/decimal" }, "weightDecimal": { "$ref": "#/$defs/decimal" } } } } } } }
  },
  "$defs": { "decimal": { "type": "string", "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]*[1-9])?$" }, "nonEmpty": { "type": "string", "minLength": 1 }, "strings": { "type": "array", "items": { "$ref": "#/$defs/nonEmpty" } } }
}
