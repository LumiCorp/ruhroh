{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://lumicorp.github.io/ruhroh/schemas/focus-update-review-v1.schema.json", "title": "Ruhroh FOCUS Update Review v1",
  "type": "object", "additionalProperties": false, "required": ["version", "reviewId", "createdAt", "fromSpecLockRef", "toSpecLockRef", "candidateReleaseStatus", "changes", "generatedRefs", "unresolvedDecisions", "verification", "recommendation"],
  "properties": { "version": { "const": "ruhroh_focus_update_review_v1" }, "reviewId": { "type": "string", "minLength": 1 }, "createdAt": { "type": "string", "format": "date-time" }, "fromSpecLockRef": { "$ref": "#/$defs/ref" }, "toSpecLockRef": { "$ref": "#/$defs/ref" }, "candidateReleaseStatus": { "enum": ["ratified", "preview"] }, "changes": { "type": "array", "items": { "$ref": "#/$defs/change" } }, "generatedRefs": { "type": "array", "items": { "$ref": "#/$defs/ref" } }, "unresolvedDecisions": { "$ref": "#/$defs/strings" }, "verification": { "type": "array", "items": { "$ref": "#/$defs/verification" } }, "recommendation": { "enum": ["no_change", "review_required", "reject"] } },
  "$defs": { "ref": { "type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": { "path": { "type": "string", "minLength": 1 }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } }, "strings": { "type": "array", "items": { "type": "string" } }, "classification": { "enum": ["editorial", "additive_optional", "additive_conditional", "additive_mandatory", "type_scale_unit_currency_nullability_applicability", "rename_deprecation_removal", "normative", "dataset", "validator"] }, "change": { "type": "object", "additionalProperties": false, "required": ["id", "classification", "sourcePath", "summary", "impactedMappings", "requiresHumanReview"], "properties": { "id": { "type": "string", "minLength": 1 }, "classification": { "$ref": "#/$defs/classification" }, "sourcePath": { "type": "string", "minLength": 1 }, "summary": { "type": "string", "minLength": 1 }, "impactedMappings": { "$ref": "#/$defs/strings" }, "requiresHumanReview": { "type": "boolean" } } }, "verification": { "type": "object", "additionalProperties": false, "required": ["name", "status"], "properties": { "name": { "type": "string", "minLength": 1 }, "status": { "enum": ["passed", "failed", "not_run"] }, "evidence": { "$ref": "#/$defs/ref" } } } }
}
