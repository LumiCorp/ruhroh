{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://lumicorp.github.io/ruhroh/schemas/focus-conformance-report-v1.schema.json", "title": "Ruhroh FOCUS Conformance Report v1",
  "$comment": "Contains sanitized rule identities and results only; raw JUnit output remains restricted.",
  "type": "object", "additionalProperties": false, "required": ["version", "reportId", "createdAt", "focusVersion", "releaseStatus", "dataset", "inputRef", "specLockRef", "conformanceProfileRef", "validator", "status", "requirements", "rules", "blockers"],
  "properties": { "version": { "const": "ruhroh_focus_conformance_report_v1" }, "reportId": { "type": "string", "minLength": 1 }, "createdAt": { "type": "string", "format": "date-time" }, "focusVersion": { "type": "string", "minLength": 1 }, "releaseStatus": { "enum": ["ratified", "preview"] }, "dataset": { "$ref": "#/$defs/dataset" }, "inputRef": { "$ref": "#/$defs/ref" }, "specLockRef": { "$ref": "#/$defs/ref" }, "conformanceProfileRef": { "$ref": "#/$defs/ref" }, "validator": { "type": "object", "additionalProperties": false, "required": ["repository", "version", "commitSha", "executable"], "properties": { "repository": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 }, "commitSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" }, "executable": { "type": "string", "minLength": 1 } } }, "status": { "enum": ["passed", "failed", "unavailable"] }, "requirements": { "$ref": "#/$defs/counts" }, "rules": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["ruleId", "status", "count"], "properties": { "ruleId": { "type": "string", "minLength": 1 }, "status": { "enum": ["passed", "failed", "skipped", "error"] }, "count": { "type": "integer", "minimum": 0 }, "message": { "type": "string", "maxLength": 240 } } } }, "blockers": { "$ref": "#/$defs/strings" } },
  "$defs": { "dataset": { "enum": ["CostAndUsage", "BillingPeriod", "InvoiceDetail", "ContractCommitment"] }, "ref": { "type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": { "path": { "type": "string", "minLength": 1 }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } }, "strings": { "type": "array", "items": { "type": "string" } }, "counts": { "type": "object", "additionalProperties": false, "required": ["evaluated", "passed", "failed", "skipped", "errors"], "properties": { "evaluated": { "type": "integer", "minimum": 0 }, "passed": { "type": "integer", "minimum": 0 }, "failed": { "type": "integer", "minimum": 0 }, "skipped": { "type": "integer", "minimum": 0 }, "errors": { "type": "integer", "minimum": 0 } } } }
}
