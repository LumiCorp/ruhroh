{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://lumicorp.github.io/ruhroh/schemas/focus-catalog-v1.schema.json", "title": "Ruhroh FOCUS Catalog v1",
  "type": "object", "additionalProperties": false, "required": ["version", "catalogId", "focusVersion", "modelRef", "datasets"],
  "properties": { "version": { "const": "ruhroh_focus_catalog_v1" }, "catalogId": { "type": "string", "minLength": 1 }, "focusVersion": { "type": "string", "minLength": 1 }, "modelRef": { "$ref": "#/$defs/ref" }, "datasets": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["dataset", "columns", "ruleIds"], "properties": { "dataset": { "type": "string", "minLength": 1 }, "columns": { "type": "array", "items": { "$ref": "#/$defs/column" } }, "ruleIds": { "$ref": "#/$defs/strings" } } } } },
  "$defs": { "ref": { "type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": { "path": { "type": "string", "minLength": 1 }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } }, "strings": { "type": "array", "items": { "type": "string" } }, "column": { "type": "object", "additionalProperties": false, "required": ["columnId", "dataType", "requirement", "applicabilityCriteria", "ruleIds"], "properties": { "columnId": { "type": "string", "minLength": 1 }, "dataType": { "type": "string", "minLength": 1 }, "requirement": { "enum": ["mandatory", "conditional", "optional"] }, "applicabilityCriteria": { "$ref": "#/$defs/strings" }, "ruleIds": { "$ref": "#/$defs/strings" } } } }
}
