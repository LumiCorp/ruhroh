{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lumicorp.github.io/ruhroh/schemas/product-engineering-decision-view-v1.schema.json",
  "title": "Ruhroh Product and Engineering Decision View v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "packetId", "readiness", "workloadBinding", "qualityEligibility", "autonomy", "businessValue", "unitEconomics", "containment", "traceFindings", "rework", "unresolvedEvidence"],
  "properties": {
    "$schema": { "const": "https://lumicorp.github.io/ruhroh/schemas/product-engineering-decision-view-v1.schema.json" },
    "version": { "const": "ruhroh_product_engineering_decision_view_v1" },
    "packetId": { "$ref": "#/$defs/nonEmptyString" },
    "readiness": { "enum": ["draft", "review_required", "decision_ready"] },
    "workloadBinding": { "$ref": "#/$defs/workloadBinding" },
    "qualityEligibility": { "$ref": "#/$defs/decisionTier" },
    "autonomy": { "$ref": "#/$defs/decisionTier" },
    "businessValue": { "$ref": "#/$defs/decisionTier" },
    "unitEconomics": { "$ref": "#/$defs/unitEconomics" },
    "containment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["budgetStatus", "interventionCount"],
      "properties": {
        "budgetStatus": { "enum": ["within", "exhausted", "overrun", "unobservable", "not_assessed"] },
        "interventionCount": { "type": "integer", "minimum": 0 }
      }
    },
    "traceFindings": { "$ref": "#/$defs/traceFindings" },
    "rework": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coverageComplete", "events", "minutes"],
      "properties": {
        "coverageComplete": { "type": "boolean" },
        "events": { "type": "integer", "minimum": 0 },
        "minutes": { "type": "number", "minimum": 0 }
      }
    },
    "unresolvedEvidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/nonEmptyString" },
      "uniqueItems": true
    },
    "decision": { "$ref": "#/$defs/signedDecision" }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "hashedSourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/nonEmptyString" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "version": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "workloadBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "experimentId", "workloadId", "projectId"],
      "properties": {
        "version": { "const": "ruhroh_workload_binding_v1" },
        "experimentId": { "$ref": "#/$defs/nonEmptyString" },
        "workloadId": { "$ref": "#/$defs/nonEmptyString" },
        "projectId": { "$ref": "#/$defs/nonEmptyString" },
        "workflowInstanceId": { "$ref": "#/$defs/nonEmptyString" },
        "hierarchyRef": { "$ref": "#/$defs/hashedSourceRef" }
      }
    },
    "decisionTier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conclusion", "evidenceLevel", "reasons", "evidenceRefs"],
      "properties": {
        "conclusion": { "enum": ["supported", "not_supported", "inconclusive", "not_assessed"] },
        "evidenceLevel": { "enum": ["declared", "measured", "independently_verified"] },
        "reasons": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmptyString" } },
        "evidenceRefs": { "type": "array", "items": { "$ref": "#/$defs/hashedSourceRef" }, "uniqueItems": true }
      }
    },
    "unitEconomics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "coverage", "reasons"],
      "properties": {
        "status": { "enum": ["supported", "not_supported", "inconclusive", "not_assessed"] },
        "coverage": { "enum": ["complete", "partial", "unknown", "unavailable"] },
        "costPerAcceptedOutcome": {
          "type": "object",
          "additionalProperties": false,
          "required": ["amount", "currency"],
          "properties": { "amount": { "type": "number", "minimum": 0 }, "currency": { "$ref": "#/$defs/nonEmptyString" } }
        },
        "tokensPerAcceptedOutcome": { "type": "number", "minimum": 0 },
        "reasons": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } }
      }
    },
    "traceFindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confirmed", "candidate", "notObservable"],
      "properties": {
        "confirmed": { "type": "integer", "minimum": 0 },
        "candidate": { "type": "integer", "minimum": 0 },
        "notObservable": { "type": "integer", "minimum": 0 }
      }
    },
    "signedDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "signerRole", "signedAt", "signatureRef", "rationale"],
      "properties": {
        "action": { "enum": ["continue", "modify", "stop"] },
        "signerRole": { "const": "accountable_decision_owner" },
        "signedAt": { "type": "string", "format": "date-time" },
        "signatureRef": { "$ref": "#/$defs/hashedSourceRef" },
        "rationale": { "$ref": "#/$defs/nonEmptyString" }
      }
    }
  }
}
