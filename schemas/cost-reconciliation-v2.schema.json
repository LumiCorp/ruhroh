{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lumicorp.github.io/ruhroh/schemas/cost-reconciliation-v2.schema.json",
  "title": "Ruhroh Cost Reconciliation v2",
  "$comment": "Exact arithmetic, coverage, and readiness invariants are enforced by the TypeScript validator.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "reconciliationId", "createdAt", "benchmarkClaimRef", "billingSourceRef", "mappingProfileRef", "source", "joins", "currencies", "coverage", "ready", "blockers", "unsupportedConcepts"],
  "properties": {
    "version": { "const": "ruhroh_cost_reconciliation_v2" },
    "reconciliationId": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "benchmarkClaimRef": { "$ref": "#/$defs/ref" }, "billingSourceRef": { "$ref": "#/$defs/ref" }, "mappingProfileRef": { "$ref": "#/$defs/ref" },
    "source": { "type": "object", "additionalProperties": false, "required": ["sourceId", "billingPeriod", "rowCount"], "properties": { "sourceId": { "type": "string", "minLength": 1 }, "billingPeriod": { "$ref": "#/$defs/period" }, "rowCount": { "type": "integer", "minimum": 0 } } }, "joins": { "type": "array", "items": { "$ref": "#/$defs/join" } }, "currencies": { "type": "array", "items": { "$ref": "#/$defs/currency" } }, "coverage": { "type": "object", "additionalProperties": false, "required": ["exactRows", "boundedRows", "allocatedRows", "ambiguousRows", "unmatchedRows"], "properties": { "exactRows": { "$ref": "#/$defs/count" }, "boundedRows": { "$ref": "#/$defs/count" }, "allocatedRows": { "$ref": "#/$defs/count" }, "ambiguousRows": { "$ref": "#/$defs/count" }, "unmatchedRows": { "$ref": "#/$defs/count" } } },
    "ready": { "type": "boolean" }, "blockers": { "type": "array", "items": { "type": "string" } }, "unsupportedConcepts": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": { "ref": { "type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": { "path": { "type": "string", "minLength": 1 }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } }, "decimal": { "type": "string", "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]*[1-9])?$" }, "count": { "type": "integer", "minimum": 0 }, "strings": { "type": "array", "items": { "type": "string" } }, "period": { "type": "object", "additionalProperties": false, "required": ["startedAt", "endedAt"], "properties": { "startedAt": { "type": "string", "format": "date-time" }, "endedAt": { "type": "string", "format": "date-time" } } }, "join": { "type": "object", "additionalProperties": false, "required": ["sourceRowId", "sourceRowSha256", "matchClass", "currency", "kind", "sourceAmountDecimal", "assignedAmountDecimal", "technicalFactIds", "workloadIds", "reason"], "properties": { "sourceRowId": { "type": "string", "minLength": 1 }, "sourceRowSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "matchClass": { "enum": ["exact", "bounded", "allocated", "ambiguous", "unmatched"] }, "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }, "kind": { "enum": ["charge", "credit", "refund", "commitment", "tax", "prepaid", "capacity", "adjustment"] }, "sourceAmountDecimal": { "$ref": "#/$defs/decimal" }, "assignedAmountDecimal": { "$ref": "#/$defs/decimal" }, "weightDecimal": { "$ref": "#/$defs/decimal" }, "technicalFactIds": { "$ref": "#/$defs/strings" }, "workloadIds": { "$ref": "#/$defs/strings" }, "reason": { "type": "string", "minLength": 1 } } }, "currency": { "type": "object", "additionalProperties": false, "required": ["currency", "sourceTotalDecimal", "assignedTotalDecimal", "differenceDecimal", "byMatchClass", "byFactKind"], "properties": { "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }, "sourceTotalDecimal": { "$ref": "#/$defs/decimal" }, "assignedTotalDecimal": { "$ref": "#/$defs/decimal" }, "differenceDecimal": { "$ref": "#/$defs/decimal" }, "byMatchClass": { "type": "object" }, "byFactKind": { "type": "object" } } } }
}
