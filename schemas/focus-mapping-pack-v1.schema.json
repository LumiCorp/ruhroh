{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://lumicorp.github.io/ruhroh/schemas/focus-mapping-pack-v1.schema.json", "title": "Ruhroh FOCUS Mapping Pack v1",
  "type": "object", "additionalProperties": false, "required": ["version", "mappingPackId", "focusVersion", "dataset", "specLockRef", "catalogRef", "mappings", "unsupportedConcepts"],
  "properties": { "version": { "const": "ruhroh_focus_mapping_pack_v1" }, "mappingPackId": { "type": "string", "minLength": 1 }, "focusVersion": { "const": "1.4" }, "dataset": { "const": "CostAndUsage" }, "specLockRef": { "$ref": "#/$defs/ref" }, "catalogRef": { "$ref": "#/$defs/ref" }, "mappings": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/mapping" } }, "unsupportedConcepts": { "type": "array", "items": { "type": "string" } } },
  "$defs": { "ref": { "type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": { "path": { "type": "string", "minLength": 1 }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } }, "strings": { "type": "array", "items": { "type": "string" } }, "mapping": { "type": "object", "additionalProperties": false, "required": ["sourceColumn", "disposition", "requirementIds", "fixtureIds", "economicallyMaterial"], "properties": { "sourceColumn": { "type": "string", "minLength": 1 }, "disposition": { "enum": ["mapped", "preserved_only", "unsupported"] }, "destinationField": { "enum": ["amountDecimal", "currency", "kind", "occurredAt", "sku"] }, "transform": { "enum": ["decimal_string", "currency_code", "charge_category_to_kind", "timestamp", "string"] }, "requirementIds": { "$ref": "#/$defs/strings" }, "fixtureIds": { "$ref": "#/$defs/strings" }, "economicallyMaterial": { "type": "boolean" }, "reason": { "type": "string" } } } }
}
