{
  "version": "ruhroh_adapter_manifest_v1",
  "adapterId": "fixture-agent",
  "adapterVersion": "1.0.0",
  "resultProtocol": "ruhroh_run_agent_result_v2",
  "traceProtocol": "ruhroh_economic_trace_span_v1",
  "resources": {
    "wallTimeMs": {
      "observable": true,
      "enforcement": "preemptive",
      "source": "runtime"
    },
    "implementationIterations": {
      "observable": true,
      "enforcement": "preemptive",
      "source": "runtime"
    },
    "modelCalls": {
      "observable": true,
      "enforcement": "boundary",
      "source": "connector"
    },
    "inputTokens": {
      "observable": true,
      "enforcement": "boundary",
      "source": "connector"
    },
    "outputTokens": {
      "observable": true,
      "enforcement": "boundary",
      "source": "connector"
    },
    "totalTokens": {
      "observable": true,
      "enforcement": "boundary",
      "source": "connector"
    },
    "cost": {
      "observable": false,
      "enforcement": "unsupported",
      "source": "connector"
    }
  }
}
