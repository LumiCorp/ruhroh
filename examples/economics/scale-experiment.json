      "requestIds": ["change-01", "change-02"]
    },
    {
      "id": "n-4",
      "n": 4,
      "scenarioId": "synthetic-changes-4",
      "scenarioVersion": "1.0.0",
      "fixtureSha256": "3333333333333333333333333333333333333333333333333333333333333333",
      "requestIds": ["change-01", "change-02", "change-03", "change-04"]
    },
    {
      "id": "n-8",
      "n": 8,
